# Copy to .env.local. NEVER commit .env.local.
# Fill these in from docs.gnani.ai (endpoint paths, header names and field
# names differ per product, so they are configurable here instead of guessed).

GNANI_API_KEY=

# Prisma (speech-to-text)
GNANI_STT_URL=
GNANI_STT_LANG=hi-IN
# Name of the multipart field that carries the audio file
GNANI_STT_FILE_FIELD=file

# Timbre (text-to-speech)
GNANI_TTS_URL=
GNANI_TTS_VOICE=
GNANI_TTS_LANG=hi-IN

# How the key is sent. Examples: "Authorization" with prefix "Bearer ", or "X-API-KEY" with empty prefix.
GNANI_AUTH_HEADER=Authorization
GNANI_AUTH_PREFIX=Bearer
